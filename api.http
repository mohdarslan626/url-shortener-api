@baseUrl = http://127.0.0.1:8000
@token = 
@url_id = 12

### Register

POST {{baseUrl}}/api/auth/register/
Content-Type: application/json

{
    "username": "test1",
    "email": "test1@example.com",
    "password": "password123"
}

### Login

POST {{baseUrl}}/api/auth/login/
Content-Type: application/json

{
    "username": "test1",
    "password": "password123"
}

### Create URL

POST {{baseUrl}}/api/shorten/
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "original_url":"https://google.com",
    "custom_alias": "Googly"
}

### My URLs

GET {{baseUrl}}/api/my-urls/
Authorization: Bearer {{token}}

### Update URL

PATCH {{baseUrl}}/api/urls/{{url_id}}/
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "original_url": "https://github.com/updated",
    "custom_alias": "arslan-git"
}

### Delete URL

DELETE {{baseUrl}}/api/urls/{{url_id}}/delete/
Authorization: Bearer {{token}}

### Dashboard

GET {{baseUrl}}/api/dashboard/
Authorization: Bearer {{token}}

#### Search URLs    
GET {{baseUrl}}/api/my-urls/?search=gitty
Authorization: Bearer {{token}}

#### page
GET {{baseUrl}}/api/my-urls/?page_size=10
Authorization: Bearer {{token}}

#### Analytics
GET {{baseUrl}}/api/analytics/googly/
Authorization: Bearer {{token}}

#### Redirect URL
GET {{baseUrl}}/api/redirect/google.com/
Authorization: Bearer {{token}}